# ---- Security ---------------------------------------------------------------------------------------------------
JWT_SECRET=
SETTINGS_ENCRYPTION_KEY=

# ---- Database: duckdb (single file, default) or postgres. Same schema and tables on both. ------------------------
DB_ENGINE=duckdb
DATA_DIR=./data
# DUCKDB_PATH=./data/codeanalyzer.duckdb
# DATABASE_URL=postgresql://codeanalyzer:secret@dbhost:5432/codeanalyzer

# ---- Ports (chosen so Code Analyzer can run next to SpecForge on 8000/7777) --------------------------------------
FRONTEND_PORT=7778
BACKEND_URL=http://127.0.0.1:8001
FRONTEND_ALLOWED_HOSTS=
# Where browsers reach the app (used for the GitHub / Bitbucket OAuth popup callback).
PUBLIC_BASE_URL=http://localhost:7778

# ---- LLM fallbacks (keys saved in Admin > LLM take precedence) -------------------------------------------------
LLM_API_KEY=
EMBEDDING_API_KEY=
GEMINI_API_KEY=

# ---- Git hosts ------------------------------------------------------------------------------------------------
# Optional OAuth apps for the "Continue with GitHub / Bitbucket" popup. Without them users sign in with a token.
# GitHub OAuth app callback:     {PUBLIC_BASE_URL}/api/git/oauth/github/callback
# Bitbucket OAuth consumer callback: {PUBLIC_BASE_URL}/api/git/oauth/bitbucket/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
BITBUCKET_OAUTH_CLIENT_ID=
BITBUCKET_OAUTH_CLIENT_SECRET=
# GitHub Enterprise and Bitbucket Server / Data Center host names, comma-separated.
GITHUB_ENTERPRISE_HOSTS=
BITBUCKET_SERVER_HOSTS=
# false accepts internal certificates for git clone and host APIs.
GIT_VERIFY_SSL=true
GIT_TIMEOUT_SECONDS=600

# ---- Analysis ---------------------------------------------------------------------------------------------------
ANALYSIS_WORKERS=2
ANALYSIS_MAX_FILES=20000
ANALYSIS_MAX_FILE_BYTES=400000
ANALYSIS_MAX_UPLOAD_MB=300

# ---- Seed users (first start only). Login IDs are plain letters and numbers. ----------------------------------------
SEED_ADMIN_LOGIN_ID=admin
SEED_ADMIN_PASSWORD=
SEED_ANALYST_LOGIN_ID=analyst
SEED_ANALYST_PASSWORD=
SEED_VIEWER_LOGIN_ID=viewer
SEED_VIEWER_PASSWORD=

# ---- Active Directory / LDAP (leave LDAP_HOST empty for local passwords only) ----------------------------------
LDAP_HOST=
LDAP_PORT=636
LDAP_DOMAINS=NTSGPDOM,NTMYPDOM
LDAP_BASE_DN=
LDAP_USER_FILTER=(&(objectClass=person)(sAMAccountName={login_id}))
LDAP_TLS_VALIDATE=false
LDAP_TIMEOUT_SECONDS=10
