//CUSTJOB  JOB (ACCT),'NIGHTLY CUST',CLASS=A,MSGCLASS=X
//* nightly customer batch
//STEP010  EXEC PGM=CUSTBAT
//CUSTIN   DD DSN=PROD.CUST.DAILY.INPUT,DISP=SHR
//CUSTMST  DD DSN=PROD.CUST.MASTER.KSDS,DISP=OLD
//RPTOUT   DD DSN=PROD.CUST.REPORT(+1),
//            DISP=(NEW,CATLG,DELETE),SPACE=(CYL,(5,5))
//SYSOUT   DD SYSOUT=*
//STEP020  EXEC PGM=IKJEFT01
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(AUDITLOG) PLAN(AUDPLAN)
  END
