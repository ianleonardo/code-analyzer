CUSTSET  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,TIOAPFX=YES
CINQMAP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,30),LENGTH=17,ATTRB=(ASKIP,BRT),                X
               INITIAL='CUSTOMER INQUIRY'
         DFHMDF POS=(4,2),LENGTH=12,ATTRB=ASKIP,INITIAL='CUSTOMER ID:'
CUSTID   DFHMDF POS=(4,15),LENGTH=10,ATTRB=(UNPROT,IC)
         DFHMDF POS=(6,2),LENGTH=5,ATTRB=ASKIP,INITIAL='NAME:'
CUSTNM   DFHMDF POS=(6,15),LENGTH=40,ATTRB=(PROT)
         DFHMSD TYPE=FINAL
         END
